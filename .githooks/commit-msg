#!/usr/bin/env bash
# Strip AI agent attribution from commit messages (AGENTS.md "Git workflow").
# Install once per clone: bash scripts/setup-git-hooks.sh (also runs on `pnpm install` in frontend/)
# Keep the patterns in sync with scripts/check_pr_rules.py, which blocks the same marks in CI.
set -euo pipefail

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  exit 0
fi

agents='(claude|anthropic|cursor|copilot|codex|gemini|chatgpt|openai|devin|aider)'
tmp="$(mktemp)"
# Keep human co-authors; drop agent trailers and "Generated with ..." lines only.
grep -viE "^[[:space:]]*(co-authored-by:.*${agents}|made[- ]with:?[[:space:]]*${agents}|.*generated[[:space:]]+(with|by)[[:space:]]+\[?${agents}|made with ${agents})" "$msg_file" >"$tmp" || true
# Trim trailing blank lines left behind by removed trailers (BSD/GNU portable).
trimmed="$(mktemp)"
awk 'BEGIN{n=0} {lines[++n]=$0} END{while(n>0 && lines[n]=="") n--; for(i=1;i<=n;i++) print lines[i]}' "$tmp" >"$trimmed"
mv "$trimmed" "$msg_file"
rm -f "$tmp"
