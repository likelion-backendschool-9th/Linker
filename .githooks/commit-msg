#!/usr/bin/env bash
# Strip Cursor agent attribution so GitHub does not list Cursor as a contributor.
# Install once per clone: bash scripts/setup-git-hooks.sh
set -euo pipefail

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  exit 0
fi

tmp="$(mktemp)"
# Keep human co-authors; drop Cursor / Made-with Cursor trailers only.
grep -viE '^(Co-authored-by:\s*Cursor\b|Made-with:\s*Cursor\b|Made with Cursor\b)' "$msg_file" >"$tmp" || true
mv "$tmp" "$msg_file"
