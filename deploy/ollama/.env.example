# Optional overrides for the standalone Ollama Compose only; contains no credentials.
OLLAMA_IMAGE=ollama/ollama:0.40.15
OLLAMA_HOST_PORT=11434
OLLAMA_CPUS=2.0
OLLAMA_MEMORY_LIMIT=4g
# Server override only. Inspect the backend's network before using this value.
OLLAMA_DOCKER_NETWORK=linker_default
# Model intentionally not selected. After agreement, pass OLLAMA_MODEL to the backend.
