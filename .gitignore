# ===== 환경변수 (절대 커밋 금지) =====
.env
.env.*
!.env.example

# ===== Accidental repo-root installs (workspaces live in frontend/, backend/) =====
/node_modules/
/package.json
/package-lock.json
/pnpm-lock.yaml
/yarn.lock

# ===== OS / IDE =====
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
*.iml

# ===== Frontend (Next.js) =====
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== Backend (Spring / Gradle) =====
backend/.gradle/
backend/build/
backend/out/
backend/bin/
!backend/gradle/wrapper/gradle-wrapper.jar
# 비밀값 담은 설정 파일을 분리한다면
backend/src/main/resources/application-secret.yml
backend/src/main/resources/application-local.yml

# ===== 개인 작업 파일 =====
.local-notes

# Server-side release bundles and deployment state (never .env or credentials).
/releases/
/.deployment-state/
deploy/tests/__pycache__/
scripts/tests/__pycache__/
scripts/__pycache__/
