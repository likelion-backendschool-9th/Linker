# Copy to `.env` and fill in real values. Do not commit `.env`.
# Compose / local Docker reads the repo-root `.env`.
# Compose uses `.env` only for ${...} substitution: the backend container receives just
# the keys listed under `backend.environment` in compose.yml. Add new keys there too.

# --- Database (required for Compose & Spring) ---
DB_URL=jdbc:postgresql://localhost:5500/linker
DB_USERNAME=linker
DB_PASSWORD=your_local_db_password

# --- Redis (host Spring; Compose overrides REDIS_HOST=redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Nginx proxy ---
# Entry: http://localhost:8000. Browser API calls use this same origin.
PROXY_PORT=8000

# --- Frontend (public / build-time) ---
# Compose builds with empty NEXT_PUBLIC_API_BASE_URL so the browser uses Nginx.
# Server-side calls in Compose use API_INTERNAL_URL=http://backend:8080.
NEXT_PUBLIC_IMAGE_HOST=
# Build-time canonical origin (metadataBase, sitemap). Never empty. Production builds take
# the GitHub Variable, falling back to https://linker.newlecture.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=

# --- Toss Payments (test mode only; payment-widget keys: test_gck_ / test_gsk_) ---
# Widget client key (browser-safe, test_gck_...). Never put the secret key in NEXT_PUBLIC_*.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# Widget secret key (test_gsk_...), server confirm/cancel only. Empty → PAYMENT_UNAVAILABLE gateway.
TOSS_SECRET_KEY=
# Same value as NEXT_PUBLIC_TOSS_CLIENT_KEY.
TOSS_CLIENT_KEY=
TOSS_API_BASE_URL=https://api.tosspayments.com

# --- GitHub webhook (optional until webhook verify is needed) ---
GITHUB_WEBHOOK_SECRET=
# GitHub App credentials are separate from the Linker session JWT keys below.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# GitHub-generated PKCS#1 or PKCS#8 RSA PEM, on one line with \n escapes.
GITHUB_APP_PRIVATE_KEY=
# GitHub App OAuth client id/secret for user login. Not the App id or the private key.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Exact web callback registered on the App, without a query. The app flow adds ?client=app.
GITHUB_USER_CALLBACK_URL=http://localhost:3000/auth/callback
# Base64 of 32 bytes. Encrypts github_tokens. Never commit a real key.
# Changing it later makes stored GitHub tokens unreadable.
GITHUB_TOKEN_ENCRYPTION_KEY=
# Operational overrides (defaults shown). No secrets in NEXT_PUBLIC_*.
GITHUB_WEB_BASE_URL=https://github.com
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_HTTP_TIMEOUT=10s
GITHUB_INSTALL_STATE_TTL=10m
GITHUB_WEBHOOK_MAX_ATTEMPTS=5
GITHUB_WEBHOOK_RETRY_DELAY=30s
GITHUB_WEBHOOK_RECEIVED_TIMEOUT=60s
GITHUB_WEBHOOK_RECOVERY_BATCH_SIZE=100
GITHUB_WEBHOOK_RECOVERY_DELAY_MS=60000
# Set false only to stop the Redis webhook consumer (e.g. a second backend instance).
LINKER_WEBHOOK_CONSUMER_ENABLED=true

# --- Session JWT (required once the auth skeleton is on) ---
# RS256. Private key is PKCS#8 PEM. Public key is SPKI PEM and must match the web JWT_PUBLIC_KEY.
# One line with \n escapes. Do not commit the private key.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Web verifier algorithm; only RS256 is issued.
JWT_ALGORITHM=RS256

# --- Session / CORS (optional; defaults work for local) ---
# Production: SESSION_COOKIE_SECURE=true and ALLOWED_ORIGINS=https://<site origin>.
SESSION_COOKIE_NAME=linker_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
ALLOWED_ORIGINS=http://localhost:3000
# Origins whose links become Linker share cards in chat. Empty → ALLOWED_ORIGINS.
CHAT_PUBLIC_ORIGINS=

# --- Object storage (optional; default unconfigured) ---
# "local" in Docker needs a volume mounted at STORAGE_LOCAL_DIR or files vanish on redeploy.
STORAGE_MODE=unconfigured
STORAGE_LOCAL_DIR=

# --- AI chat summary (Ollama; see deploy/ollama) ---
# Host Spring: empty disables calls. Compose defaults to the sidecar at http://ollama:11434.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3:4b
OLLAMA_CONNECT_TIMEOUT=5s
OLLAMA_READ_TIMEOUT=120s

# --- Recruiter mail (SMTP). Dev uses Mailpit; a production relay is not chosen. ---
# Empty MAIL_HOST keeps signup and reset from pretending a message was sent.
# Mailpit: SMTP localhost:1025, inbox http://localhost:8025
MAIL_HOST=
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Linker <noreply@linker.local>
MAIL_PUBLIC_BASE_URL=http://localhost:3000

# C page 11: enable after B schema + agreed C migration and B/C webhook sample verification.
ISSUE_SYNC_ENABLED=false
ISSUE_WEBHOOK_ENABLED=false

# B page 08: enable after agreed migrations and verified B/C schema + webhook samples.
TEAM_SETUP_WORKER_ENABLED=false
TEAM_SETUP_WEBHOOK_ENABLED=false
TEAM_SETUP_POLL_DELAY_MS=5000
