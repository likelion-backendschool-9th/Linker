DB_URL=jdbc:postgresql://localhost:5500/linker
DB_USERNAME=linker
DB_PASSWORD=your_local_db_password

# Nginx entry point: http://localhost:8000. Browser API calls use this same origin.
PROXY_PORT=8000
# Server-side calls in Compose use API_INTERNAL_URL=http://backend:8080.
NEXT_PUBLIC_IMAGE_HOST=

# Public Toss widget test client key; secret keys belong only on the backend.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
