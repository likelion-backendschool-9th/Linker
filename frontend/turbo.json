{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {
      "cache": false,
      "env": ["OPENAPI_URL"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*", "API_INTERNAL_URL"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "env": ["API_INTERNAL_URL"],
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {}
  }
}
