# Spring origin for direct local development. Compose builds with an empty origin
# so browser API requests go through Nginx at http://localhost:8000 instead.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Optional server-only origin; Docker Compose sets this to http://backend:8080.
API_INTERNAL_URL=http://localhost:8080
# Upload storage host for next/image (photos uploaded via presigned URL)
NEXT_PUBLIC_IMAGE_HOST=
# Public site origin for metadataBase, canonical and OG URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# STOMP endpoint. Empty → API origin (or this origin behind Nginx) + /ws
NEXT_PUBLIC_WS_URL=

# proxy.ts reads the session JWT claims (blueprint §4-3, ch. 15). Without a key every visitor is a guest.
# Backend public key in PEM; one line with \n escapes is fine.
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
# Session cookie name; align with the backend once it is decided
SESSION_COOKIE_NAME=linker_session

# Mock data mode (blueprint §1-2): answer every API call from src/mocks/ instead of Spring.
# `pnpm dev:mock` sets it for you. Leave empty/false once the backend is up.
NEXT_PUBLIC_USE_MOCKS=
