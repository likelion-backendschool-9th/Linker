# Copy to .env.remote-db (ignored by Git) and chmod 600 .env.remote-db.
# macOS / WSL / Linux: see docs/operations/05-database-access.md.
# This file is for remote_db.py, not Docker Compose. Do not source it in a shell.
# An empty password is requested interactively when starting the backend.
DB_PASSWORD=

# Optional personal overrides. Do not use the restricted deployment key.
# SSH_KEY_FILE=~/.ssh/linker_db
# SSH_USER=linker
# DB_USERNAME=linker
# LOCAL_DB_PORT=15432
# Redis must already be running; backend mode checks PONG before SSH/Spring.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# Use a free port different from LOCAL_DB_PORT; backend mode checks both.
# BACKEND_PORT=8080
